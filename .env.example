# CONFIT environment template — variable NAMES only, never real values.
# Copy to .env (or backend/.env) and fill in locally. .env is gitignored.

# Application
APP_ENV=development
ENVIRONMENT=development
DEBUG=true

# Database (Alembic + runtime). Never commit real credentials.
DATABASE_URL=sqlite:///./backend/data/confit.db
# ALEMBIC_DATABASE_URL=postgresql+psycopg://user:password@host:5432/confit

# Security — replace ALL defaults in production (boot refuses defaults there).
SECRET_KEY=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY_FOR_BODY_DATA=
# Dedicated audit-chain HMAC key (tamper-evident audit log, migration 0020)
AUDIT_HMAC_KEY=
AUDIT_CHAIN_KEY_VERSION=1

# AI providers (server-side only; never expose to the frontend bundle)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Groq (api.groq.com). GROQ_API_KEY is the documented name in
# docs/PRODUCTION_DEPLOYMENT_CONTRACT.md; GROK_API_KEY is accepted as a
# legacy alias. Set either one.
GROQ_API_KEY=
GROK_API_KEY=

# ── NVIDIA NIM (integrate.api.nvidia.com) ───────────────────────────────────
# Legacy single-key contract, still read by orchestrator.py and ai_readiness.py.
NVIDIA_API_KEY=
NVIDIA_CHAT_KEY_2=
#
# Role-routed pool consumed by backend/app/providers/nvidia/. Keys are
# ACCOUNT-scoped (verified: any key can invoke any model), so the client
# rotates across the pool when a NIM worker answers 429/503 ResourceExhausted.
# The pool is OPTIONAL — with none of these set the provider reports
# configured=false and callers degrade honestly. Model bindings and the
# measured evidence for each are in docs/NVIDIA_MODEL_ROUTING.md.
#
# AI Stylist (G2-02)
NVIDIA_KEY_NEMOTRON_3_ULTRA_550B_A55B=
NVIDIA_KEY_NEMOTRON_3_SUPER_120B_A12B=
NVIDIA_KEY_KIMI_K3=
# Wardrobe auto-tagging / Visual Search attributes (vision)
NVIDIA_KEY_DIFFUSIONGEMMA_26B_A4B_IT=
NVIDIA_KEY_NEMOTRON_3_NANO_OMNI_30B_A3B_REASONING=
# Upload + chat moderation
NVIDIA_KEY_NEMOTRON_3_5_CONTENT_SAFETY=
# Arabic <-> English localisation
NVIDIA_KEY_RIVA_TRANSLATE_4B_INSTRUCT_V2=
# Offline Celery analytics / creative copy
NVIDIA_KEY_GLM_5_3=
NVIDIA_KEY_GLM_5_3_FLASH=
NVIDIA_KEY_MUSE_GLIMMER_30B=
# Cheap structured helpers
NVIDIA_KEY_NEMOTRON_3_5_LIGHTNING_30B_A3B=
# Retrieval vectors — INFRASTRUCTURE ONLY, no product path may call it yet
# (MODEL_REGISTRY.json forbids shipping an unused embedding model).
NVIDIA_KEY_NEMOTRON_3_EMBED_1B=
# Held in the pool as overflow credentials; their models are NOT routed
# (see UNROUTED_MODELS in backend/app/providers/nvidia/registry.py).
NVIDIA_KEY_DEEPSEEK_V4_1_FLASH=
NVIDIA_KEY_GEMMA_4_31B_IT=
NVIDIA_KEY_LAGUNA_XS_2_1=
NVIDIA_KEY_KUMO_RELATIONAL=
NVIDIA_KEY_NEMOTRON_VOICECHAT=
NVIDIA_KEY_ISING_CALIBRATION_1_5_31B=
NVIDIA_KEY_ISING_CALIBRATION_1_5_31B_2=

# Weather (G2-S5) — disabled until explicitly enabled with a real key.
# When disabled or failing, the dashboard returns weather=null (never fake).
OPENWEATHER_ENABLED=false
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_TIMEOUT_SECONDS=10
OPENWEATHER_UNITS=metric

# Object storage for user uploads (wardrobe photos, mood-board tiles).
# STORAGE_PROVIDER=local is a development convenience ONLY: on Vercel the
# function filesystem is read-only/ephemeral, so production uploads fail with
# 501 FEATURE_NOT_CONFIGURED until a durable object store is configured.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./backend/data/uploads
# S3-compatible object stores (AWS S3, Cloudflare R2, Neon Object Storage,
# MinIO, B2). Path-style addressing is used automatically for non-AWS stores.
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Endpoint for non-AWS S3-compatible stores. Both names are accepted;
# S3_ENDPOINT_URL wins (AWS_ENDPOINT_URL_S3 is the AWS-SDK/Neon convention).
S3_ENDPOINT_URL=
AWS_ENDPOINT_URL_S3=
# Private buckets reject anonymous browser reads; the API returns short-lived
# presigned GET URLs for owned objects instead (TTL in seconds). The database
# stores the canonical URL — never a signed one.
S3_PRESIGN_EXPIRY_SECONDS=3600

# Commerce / payments (Group 5). Never put live secrets in frontend code.
PAYMENTS_LIVE=false
BNPL_DEFAULT_PROVIDER=tabby
PAYMENT_DEFAULT_PROVIDER=mock
TABBY_API_KEY=
TAMARA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
TAX_RATE=0.05
FREE_SHIPPING_THRESHOLD=250
STANDARD_SHIPPING_FEE=15
EXPRESS_SHIPPING_FEE=35
RETURN_WINDOW_DAYS=30

# GitHub credentials are NOT application config — configure git/gh outside the repo.

# pilot | commercial — which licence class of try-on engine may serve.
VTON_LICENSE_TIER=pilot

# ── Presentation & settlement currency (2026-09-30) ─────────────────────────
# MARKET_FX_RATES is consumed by BOTH settlement
# (providers/payment/capability_registry.py) and display
# (services/pricing_presentation.py), so a shopper can never see one currency
# and be charged in another. It is a JSON object of CURRENCY -> rate FROM
# PRICING_CURRENCY. A market currency with no rate here is served in
# PRICING_CURRENCY and reported as `available: false` by
# GET /catalog/currencies — never rendered at a silent 1:1, because labelling
# a 289 USD price "EGP 289" is a ~52x error, not a cosmetic one.
# Clients choose with the `X-Currency` header or `?currency=` (see
# frontend/src/lib/currency.ts; the browser never holds a rate).
PRICING_CURRENCY=USD
MARKET_FX_RATES={"EGP":"52.092039","SAR":"3.75","AED":"3.6725","QAR":"3.64","KWD":"0.308442","BHD":"0.376","OMR":"0.384497"}

# LIVE rates (services/fx_rates.py, added 2026-09-30). The static table above
# is now only the LAST-RESORT fallback: rates are fetched from
# exchangerate-api's open endpoint (no key, 166 currencies, daily refresh),
# cached in-process for FX_RATE_TTL_SECONDS, and degraded
# live -> last good snapshot -> MARKET_FX_RATES -> empty. Failure never
# raises: money resolution is on the checkout critical path.
# Set FX_LIVE_RATES_ENABLED=false to pin the storefront to the static table
# (e.g. a treasury freeze). Live fetching is ALWAYS off under
# CONFIT_IGNORE_DOTENV=1 so pytest never depends on a vendor's uptime.
FX_LIVE_RATES_ENABLED=true
FX_RATE_TTL_SECONDS=21600

# The currency the storefront DISPLAYS when the shopper has no preference and
# the market gives no stronger signal. Deliberately SEPARATE from
# PRICING_CURRENCY (the denomination the price book is stored in) — changing
# the storefront default must not require re-denominating every product row.
DEFAULT_DISPLAY_CURRENCY=EGP
