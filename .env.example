# CONFIT environment template — variable NAMES only, never real values.
# Copy to .env (or backend/.env) and fill in locally. .env is gitignored.

# Application
APP_ENV=development
ENVIRONMENT=development
DEBUG=true

# Database (Alembic + runtime). Never commit real credentials.
DATABASE_URL=sqlite:///./backend/data/confit.db
# ALEMBIC_DATABASE_URL=postgresql+psycopg://user:password@host:5432/confit

# Security — replace ALL defaults in production (boot refuses defaults there).
SECRET_KEY=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY_FOR_BODY_DATA=

# AI providers (server-side only; never expose to the frontend bundle)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
NVIDIA_API_KEY=

# Weather (G2-S5) — disabled until explicitly enabled with a real key.
# When disabled or failing, the dashboard returns weather=null (never fake).
OPENWEATHER_ENABLED=false
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_TIMEOUT_SECONDS=10
OPENWEATHER_UNITS=metric

# Commerce / payments (Group 5). Never put live secrets in frontend code.
PAYMENTS_LIVE=false
BNPL_DEFAULT_PROVIDER=tabby
PAYMENT_DEFAULT_PROVIDER=mock
TABBY_API_KEY=
TAMARA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
TAX_RATE=0.05
FREE_SHIPPING_THRESHOLD=250
STANDARD_SHIPPING_FEE=15
EXPRESS_SHIPPING_FEE=35
RETURN_WINDOW_DAYS=30

# GitHub credentials are NOT application config — configure git/gh outside the repo.
