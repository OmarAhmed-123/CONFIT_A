# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
env/
venv/

# Environment Variables & Secrets
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!*.example
!backend/.env.example
!frontend/.env.example

# SQLite and database data — ALL local databases are untracked. The app
# self-seeds on an empty database at startup (see README "Local setup"), so a
# versioned confit.db is unnecessary and only served to pollute commits with
# local dev/E2E mutations (observed during Group 4 E2E runs). Production data
# lives in the managed Postgres (DATABASE_URL) and is never committed.
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/uploads/*
!backend/data/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Testing & Cache
.pytest_cache/
.cache/
.coverage

# Node.js / Frontend dependencies & builds
node_modules/
frontend/node_modules/
frontend/dist/
.npm/

# Logs & OS artifacts
*.log
.DS_Store
.vscode/
.idea/
