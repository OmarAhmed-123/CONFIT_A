# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
env/
venv/

# Environment Variables & Secrets
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!*.example
!backend/.env.example
!frontend/.env.example

# SQLite and database data
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/uploads/*
!backend/data/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Testing & Cache
.pytest_cache/
.cache/
.coverage

# Node.js / Frontend dependencies & builds
node_modules/
frontend/node_modules/
frontend/dist/
.npm/

# Logs & OS artifacts
*.log
.DS_Store
.vscode/
.idea/
