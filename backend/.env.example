# ════════════════════════════════════════════════════════════════════════════
# CONFIT Backend Environment Template (.env.example)
# Copy to `backend/.env` and supply actual secret keys in development/production.
# ════════════════════════════════════════════════════════════════════════════

# ── 1 · Application Core & Networking ─────────────────────────────────────────
PROJECT_NAME="CONFIT"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
API_V1_STR="/api/v1"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:43123,http://127.0.0.1:43123"

# ── 2 · Cryptographic Secrets & JWT ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app REFUSES to boot in production while these hold placeholder/default values.
SECRET_KEY="CHANGE_ME_generate_with_secrets_token_urlsafe_48"
JWT_REFRESH_SECRET="CHANGE_ME_generate_with_secrets_token_urlsafe_48"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY_FOR_BODY_DATA="CHANGE_ME_32_bytes_minimum_random"

# ── 3 · Relational Database & Redis Cache ─────────────────────────────────────
DATABASE_URL="postgresql://CHANGE_USER:CHANGE_PASSWORD@localhost:5432/confit_db"
# SQLite alternative for zero-dependency local dev:
# DATABASE_URL="sqlite:///./backend/data/confit.db"
REDIS_URL="redis://localhost:6379/0"

# ── 4 · AI Stylist & LLM Provider Chain (Server-Side Only) ───────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
# Groq (api.groq.com). Set GROQ_API_KEY (documented in
# docs/PRODUCTION_DEPLOYMENT_CONTRACT.md) or the legacy alias GROK_API_KEY.
GROQ_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_CHAT_KEY_2=

# Failover execution order (comma-separated):
AI_PROVIDERS="gemini,nvidia,openai,grok,openrouter"
AI_STYLIST_PROVIDER="hybrid"
CHAT_COOLDOWN_MS=600000

# ── 5 · Diffusion Virtual Try-On (VTON) & Video Render ───────────────────────
KLING_API_KEY=
KLING_BASE="https://api.klingai.com/v1"
KLING_TRYON_MODEL="kolors-virtual-try-on-v1-5"

TRYON_IMAGE_PROVIDERS="gemini,kling,nvidia"
TRYON_ANONYMOUS_EXPIRY_HOURS=24
TRYON_PER_HOUR=20

# ── 6 · Computer Vision & Semantic Search ────────────────────────────────────
VISION_MODEL="gemini-flash-lite-latest"
VISION_TIMEOUT_MS=30000

SEARCH_URL="http://localhost:7700"
MEILI_MASTER_KEY="CHANGE_ME"

# ── 7 · Payments, BNPL & Multi-Market Rails ──────────────────────────────────
PAYMENTS_LIVE=0
PAYMENT_DEFAULT_PROVIDER="mock"
BNPL_DEFAULT_PROVIDER="tabby"
TABBY_API_KEY=
TAMARA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
TAX_RATE=0.05
FREE_SHIPPING_THRESHOLD=250
STANDARD_SHIPPING_FEE=15
EXPRESS_SHIPPING_FEE=35
RETURN_WINDOW_DAYS=30

# Market selection: EG (EGP x48.5) · AE (AED x3.6725) · SA (SAR x3.75)
MARKET="EG"

# ── 8 · Object Storage & S3 ───────────────────────────────────────────────────
# STORAGE_PROVIDER=local is a DEVELOPMENT convenience only. On Vercel the
# function filesystem is read-only/ephemeral, so every upload feature
# (wardrobe photos, mood-board, generated assets) answers 501
# FEATURE_NOT_CONFIGURED in production until object storage is configured.
# Set STORAGE_PROVIDER=s3 in production. Both naming conventions below are
# honoured by the same resolver (Settings.s3_bucket / s3_access_key /
# s3_secret_key / s3_endpoint_url) — pick ONE, do not mix.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./backend/data/uploads"

# Canonical (AWS_* / S3_ENDPOINT_URL) — preferred:
AWS_S3_BUCKET="confit-a-media"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="eu-central-1"
# Endpoint only for S3-COMPATIBLE stores (Cloudflare R2, Neon storage, MinIO).
# Leave empty for real AWS S3 (the virtual-host URL is derived from the bucket).
S3_ENDPOINT_URL=
# Optional CDN/custom public base for the URLs returned by store().
S3_PUBLIC_URL_BASE=

# Legacy aliases (still accepted, resolved to the same values):
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_PRIVATE="confit-private"
S3_BUCKET_PUBLIC="confit-public"

# Server-side encryption declared on every PUT (personal photos are involved).
S3_SERVER_SIDE_ENCRYPTION="AES256"
# Live bucket probe behind /health (put/get/delete round trip, cached).
# Enable in production so /health reports reachability, not just env presence.
STORAGE_PROBE_ENABLED=false
STORAGE_PROBE_TIMEOUT_SECONDS=5.0
STORAGE_PROBE_TTL_SECONDS=300.0

# ── 9 · Transactional Email & Notifications ───────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="CHANGE_ME@example.com"
SMTP_PASS=""
MAIL_FROM_NAME="CONFIT"

# ── 10 · Privacy Policy & B2B K-Anonymity ─────────────────────────────────────
POLICY_VERSION=3
ANALYTICS_K_MIN=20
DUPLICATE_ALERT_SIMILARITY_THRESHOLD=0.82
