# ════════════════════════════════════════════════════════════════════════════
# CONFIT Backend Environment Template (.env.example)
# Copy to `backend/.env` and supply actual secret keys in development/production.
# ════════════════════════════════════════════════════════════════════════════

# ── 1 · Application Core & Networking ─────────────────────────────────────────
PROJECT_NAME="CONFIT"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
API_V1_STR="/api/v1"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ── 2 · Cryptographic Secrets & JWT ──────────────────────────────────────────
SECRET_KEY="confit_super_secret_jwt_encryption_key_2026_production_grade"
JWT_REFRESH_SECRET="confit_super_secret_refresh_token_key_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY_FOR_BODY_DATA="confit_body_privacy_encryption_secret_key_32bytes!"

# ── 3 · Relational Database & Redis Cache ─────────────────────────────────────
DATABASE_URL="postgresql://confit_user:confit_secure_password_2026@localhost:5432/confit_db"
# SQLite alternative for zero-dependency local dev:
# DATABASE_URL="sqlite:///./backend/data/confit.db"
REDIS_URL="redis://localhost:6379/0"

# ── 4 · AI Stylist & LLM Provider Chain (Server-Side Only) ───────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
NVIDIA_CHAT_KEY_2=

# Failover execution order (comma-separated):
AI_PROVIDERS="gemini,nvidia,openai,grok,openrouter"
AI_STYLIST_PROVIDER="hybrid"
CHAT_COOLDOWN_MS=600000

# ── 5 · Diffusion Virtual Try-On (VTON) & Video Render ───────────────────────
KLING_API_KEY=
KLING_BASE="https://api.klingai.com/v1"
KLING_TRYON_MODEL="kolors-virtual-try-on-v1-5"

NVIDIA_IMAGE_KEY=
NVIDIA_IMAGE_MODEL="black-forest-labs/flux.2-klein-4b"

TRYON_IMAGE_PROVIDERS="gemini,kling,nvidia"
TRYON_ANONYMOUS_EXPIRY_HOURS=24
TRYON_PER_HOUR=20

# ── 6 · Computer Vision & Semantic Search ────────────────────────────────────
VISION_MODEL="gemini-3.1-flash-lite"
VISION_TIMEOUT_MS=30000

NVIDIA_EMBED_KEY=
NVIDIA_EMBED_MODEL="nvidia/nemotron-3-embed-1b"
NVIDIA_RERANK_KEY=
NVIDIA_RERANK_MODEL="nvidia/llama-nemotron-rerank-vl-1b-v2"
SEARCH_URL="http://localhost:7700"
MEILI_MASTER_KEY="confit_meili_master_key_2026"

# ── 7 · Payments, BNPL & Multi-Market Rails ──────────────────────────────────
PAYMENTS_LIVE=0
PAYMENT_DEFAULT_PROVIDER="mock"
BNPL_DEFAULT_PROVIDER="tabby"
TABBY_API_KEY=
TAMARA_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Market selection: EG (EGP x48.5) · AE (AED x3.6725) · SA (SAR x3.75)
MARKET="EG"
FULFILL_PACE="demo"

# ── 8 · Object Storage & S3 ───────────────────────────────────────────────────
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./backend/data/uploads"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_PRIVATE="confit-private"
S3_BUCKET_PUBLIC="confit-public"

# ── 9 · Transactional Email & Notifications ───────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="omarsafealden@gmail.com"
SMTP_PASS=""
MAIL_FROM_NAME="CONFIT"

# ── 10 · Privacy Policy & B2B K-Anonymity ─────────────────────────────────────
POLICY_VERSION=3
ANALYTICS_K_MIN=20
DUPLICATE_ALERT_SIMILARITY_THRESHOLD=0.82
