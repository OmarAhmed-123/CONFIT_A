  "test_cases": [
    {
      "id": "TC001",
      "description": "Exact category match - tops",
      "vision_output": {
        "detected_category": "Tops",
        "detected_color": "navy",
        "detected_pattern": "Solid",
        "detected_style": "Smart Casual"
      },
      "expected_top_results": ["tops"],
