        "detected_style": "Casual"
      },
      "expected_top_results": ["dresses"],
      "should_not_match": ["tops", "bottoms", "outerwear"]
    },
    {
      "id": "TC004",
      "description": "Synonym test - tee vs t-shirt",
      "vision_output": {
        "detected_category": "Tops",
        "detected_color": "white",
        "detected_pattern": "Solid",
        "detected_style": "Casual"
      },
      "search_query": "tee",
      "expected_match": ["t-shirt", "tee"],
      "synonym_mapping": {"tee": "t-shirt"}
    },
    {
      "id": "TC005",
      "description": "Synonym test - trousers vs pants",
      "vision_output": {
        "detected_category": "Bottoms",
        "detected_color": "gray",
        "detected_pattern": "Solid",
        "detected_style": "Formal"
      },
      "search_query": "trousers",
      "expected_match": ["pants", "trousers"],
      "synonym_mapping": {"trousers": "pants"}
    },
    {
      "id": "TC006",
