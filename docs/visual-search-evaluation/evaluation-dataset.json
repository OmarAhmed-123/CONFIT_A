    },
    {
      "id": "TC002",
      "description": "Exact category match - bottoms",
      "vision_output": {
        "detected_category": "Bottoms",
        "detected_color": "black",
        "detected_pattern": "Solid",
        "detected_style": "Formal"
      },
      "expected_top_results": ["bottoms"],
      "should_not_match": ["tops", "dresses", "outerwear"]
    },
    {
      "id": "TC003",
      "description": "Exact category match - dresses",
      "vision_output": {
        "detected_category": "Dresses",
        "detected_color": "red",
