      "vision_output": {
        "detected_category": "Tops",
        "detected_color": "blue",
        "detected_pattern": "Striped",
        "detected_style": "Casual"
      },
      "product_category": "shirt",
      "should_match": true,
      "hierarchy_relationship": "child"
    },
    {
      "id": "TC008",
      "description": "Category hierarchy - jacket is child of outerwear",
      "vision_output": {
        "detected_category": "Outerwear",
        "detected_color": "black",
        "detected_pattern": "Solid",
        "detected_style": "Smart Casual"
      },
      "product_category": "jacket",
      "should_match": true,
      "hierarchy_relationship": "child"
    },
    {
      "id": "TC009",
