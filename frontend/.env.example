# ════════════════════════════════════════════════════════════════════════════
# CONFIT Frontend Client Environment Template (.env.example)
# Client-safe configuration. NEVER place secret provider keys here.
# ════════════════════════════════════════════════════════════════════════════

VITE_APP_NAME="CONFIT"
VITE_API_BASE_URL="/api/v1"
VITE_AI_PROXY_URL="/api/chat"

# Market & Localization defaults: EG (Egypt/EGP), AE (UAE/AED), SA (Saudi/SAR)
VITE_MARKET="EG"
VITE_DEFAULT_LOCALE="en"

# MediaPipe On-Device Body-Scan Vision Models (Client-Side Privacy Engine)
VITE_MP_WASM="https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm"
VITE_MP_POSE_URL="https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/latest/pose_landmarker_full.task"
VITE_MP_FACE_URL="https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/latest/face_landmarker.task"
VITE_MP_HAND_URL="https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/latest/hand_landmarker.task"

# OIDC Social Client IDs (Public identifiers only)
VITE_GOOGLE_CLIENT_ID=""
VITE_APPLE_CLIENT_ID=""
VITE_FACEBOOK_CLIENT_ID=""
